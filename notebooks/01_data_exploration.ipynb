   "source": [
    "# 01. Exploration du Carnet d'Ordres (EDA)\n",
    "\n",
    "Ce notebook permet d'explorer les données brutes collectées via WebSocket."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams[\"figure.figsize\"] = (12, 6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Charger un échantillon de données brutes\n",
    "data_dir = Path(\"../data/raw\")\n",
    "files = sorted(data_dir.glob(\"*.parquet\"))\n",
    "if not files:\n",
    "    print(\"Aucun fichier Parquet trouvé. Veuillez collecter des données d'abord.\")\n",
    "else:\n",
    "    df = pd.read_parquet(files[0])\n",
    "    print(f\"Données chargées : {len(df)} lignes, {len(df.columns)} colonnes\")\n",
    "    display(df.head())"
   ]
  }
